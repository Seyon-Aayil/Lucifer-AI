# =============================================================================
# Lucifer AI — Environment Variables Reference
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=<generate-with-openssl>     # openssl rand -hex 32
LOG_LEVEL=INFO

# --- Auth (JWT) ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600          # 1 hour
JWT_REFRESH_TOKEN_TTL_SECONDS=604800       # 7 days

# --- Master API ---
MASTER_API_HOST=0.0.0.0
MASTER_API_PORT=8000

# --- PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lucifer
POSTGRES_USER=lucifer
POSTGRES_PASSWORD=<change-me>
DATABASE_URL=postgresql+asyncpg://lucifer:<change-me>@localhost:5432/lucifer

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<change-me>
NEO4J_DATABASE=neo4j

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=lucifer

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<change-me>
MINIO_BUCKET=lucifer-artifacts
MINIO_SECURE=false

# --- LiteLLM Proxy ---
LITELLM_PROXY_URL=http://localhost:8080
LITELLM_MASTER_KEY=<generate-with-openssl>

# --- RouteLLM ---
ROUTELLM_THRESHOLD=0.5                     # 0=always weak, 1=always strong
ROUTELLM_STRONG_MODEL=anthropic/claude-opus-4
ROUTELLM_WEAK_MODEL=anthropic/claude-haiku-4

# --- LLM Provider API Keys ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# --- vLLM (self-hosted, optional) ---
VLLM_BASE_URL=http://localhost:8081/v1
VLLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- Mem0 ---
MEM0_API_URL=http://localhost:8090
MEM0_API_KEY=<change-me>

# --- Zep ---
ZEP_API_URL=http://localhost:8091
ZEP_API_KEY=<change-me>

# --- GPTCache (Semantic Cache) ---
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_ENABLED=true

# --- Token Optimizer ---
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-large-multilingual-cased-meetingbank
TOKEN_OPTIMIZER_ENABLED=true

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=lucifer-master
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# --- MCP Integrations: Google OAuth ---
GOOGLE_CLIENT_ID=<from-google-cloud-console>
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- MCP Integrations: GitHub App ---
GITHUB_APP_ID=<app-id>
GITHUB_APP_PRIVATE_KEY_PATH=./infra/secrets/github_app.pem

# --- MCP Integrations: Notion ---
NOTION_CLIENT_ID=<from-notion-integrations>
NOTION_CLIENT_SECRET=<from-notion-integrations>

# --- MCP Integrations: Slack ---
SLACK_CLIENT_ID=<from-slack-app>
SLACK_CLIENT_SECRET=<from-slack-app>
SLACK_SIGNING_SECRET=<from-slack-app>

# --- News Sync ---
NEWS_SCHEDULER_ENABLED=true
NEWS_DEFAULT_FETCH_CADENCE_MINUTES=60

# --- Crypto ---
# User-derived keys — NEVER stored in env. Derived at runtime via Argon2id.
# These are used ONLY for local development stubs:
DEV_ENCRYPTION_KEY=<only-for-local-dev>

# --- Benchmark / Model Upgrade ---
BENCHMARK_ENABLED=true
BENCHMARK_SCHEDULE_CRON="0 2 * * *"       # 2am daily
SHADOW_EVAL_SAMPLE_SIZE=100
